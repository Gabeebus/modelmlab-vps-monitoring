[Unit]
Description=VPS health watchdog
After=network-online.target docker.service tailscaled.service crowdsec.service
Wants=network-online.target
ConditionPathExists=/etc/modelmlab-monitoring/monitoring.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/modelmlab-monitoring/monitoring.env
ExecStart=/usr/local/libexec/modelmlab-monitoring/vps-watchdog check
TimeoutStartSec=180s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/modelmlab-monitoring/watchdog
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
