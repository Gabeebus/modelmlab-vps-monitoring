# Configuration only. Put actual webhook URLs in separate root-only files.
MONITOR_HTTPS_HOST=monitor.example.com
MONITOR_HTTPS_PATHS="/ /privacy/ /terms/"
MONITOR_TRAEFIK_CONFIG=/etc/traefik/traefik_config.yml
MONITOR_COMPOSE_DIR=/opt/pangolin
MONITOR_COMPOSE_FILE=/opt/pangolin/docker-compose.yml
MONITOR_REPORT_TZ=UTC
MONITOR_WATCHDOG_WEBHOOK_FILE=/etc/modelmlab-monitoring/watchdog-webhook.url
MONITOR_UPDATER_WEBHOOK_FILE=/etc/modelmlab-monitoring/updater-webhook.url
